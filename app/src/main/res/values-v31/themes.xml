<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PortPerson" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:colorBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
        <!-- Android 12+ system splash: plain dark background; the app's own splash shows the icon. -->
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>
</resources>
